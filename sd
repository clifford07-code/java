import java.util.*;

class Car {
    private String model;
    private double price;
    private double mileage;

    Car(String model, double price, double mileage) {
        this.model = model;
        this.price = price;
        this.mileage = mileage;
    }

    public double getPrice() {
        return price;
    }

    public void display() {
        System.out.println("Model: " + model + ", Price: " + price + ", Mileage: " + mileage);
    }
}

public class CarShowroom {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter number of cars: ");
        int n = sc.nextInt();

        Car[] cars = new Car[n];

        for (int i = 0; i < n; i++) {
            sc.nextLine();
            System.out.println("Enter details of car " + (i + 1));
            System.out.print("Model: ");
            String model = sc.nextLine();
            System.out.print("Price: ");
            double price = sc.nextDouble();
            System.out.print("Mileage: ");
            double mileage = sc.nextDouble();

            cars[i] = new Car(model, price, mileage);
        }

        Car expensive = cars[0];
        for (int i = 1; i < n; i++) {
            if (cars[i].getPrice() > expensive.getPrice()) {
                expensive = cars[i];
            }
        }

        System.out.println("\nMost Expensive Car:");
        expensive.display();
    }
}
